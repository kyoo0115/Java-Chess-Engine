# EPD Puzzle Suite — engine-verified positions
# Format:  <FEN 4-field> bm <coord-move(s)>; id "<name>"; c0 "<comment>";
# Coord notation: from-to (e2e4). Promotion: a7a8 accepted as a7a8q.
# Any listed move is accepted as correct.

# ── Mate in 1 ────────────────────────────────────────────────────────────────

# Back-rank mate: White Re1+Kg1, Black Kg8+pawns f7/g7/h7. 1.Re8#
6k1/5ppp/8/8/8/8/5PPP/4R1K1 w - - bm e1e8; id "M1-back-rank"; c0 "Re8#";

# KQK corner: White Ka6+Qb6, Black Ka8. Both Qb7# and Qa7# are checkmate.
# Qb7: Ka8→b8 covered by Qb7, Ka8→a7 covered by Ka6.
# Qa7: Ka8→b8 covered by Qa7 diagonally, Ka8→b7 covered by Ka6.
k7/8/KQ6/8/8/8/8/8 w - - bm b6b7 b6a7; id "M1-queen-corner"; c0 "Qb7# or Qa7# (both checkmate Ka8)";

# KRK corner: White Ra1+Kb6, Black Ka8. 1.Ra8#
# Ka8→b8 covered by Kb6; Ka8→a7 covered by Ra8 on a-file.
k7/8/1K6/8/8/8/8/R7 w - - bm a1a8; id "M1-rook-corner"; c0 "Ra8# — Kb6 covers b8";

# ── Tactics ──────────────────────────────────────────────────────────────────

# Free queen: White Ne5, Black Qc6 undefended. 1.Nxc6 wins queen for knight.
r3k3/8/2q5/4N3/8/8/8/4K3 w - - bm e5c6; id "TAC-free-queen"; c0 "Ne5xc6 wins queen";

# ── Endgame ───────────────────────────────────────────────────────────────────

# Pawn promotes: White Pa7+Ka5, Black Kc7 too far. 1.a8=Q
8/P7/8/K7/8/8/8/2k5 w - - bm a7a8; id "END-promo"; c0 "a8=Q";

# Rook mate: White Ra1+Kd6, Black Kd8. 1.Ra8#
3k4/8/3K4/8/8/8/8/R7 w - - bm a1a8; id "END-rook-mate"; c0 "Ra8#";
